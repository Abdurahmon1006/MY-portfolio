# My Portfolio — namunaviy muhit sozlamalari
#
# Ishlatish: bu faylni `.env` nomi bilan nusxalab, qiymatlarni to'ldiring:
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)

# Django maxfiy kaliti (yangi kalit: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())")
DJANGO_SECRET_KEY=bu-yerga-yangi-maxfiy-kalit

# Ishlab chiqishda True, serverda (production) False
DJANGO_DEBUG=True

# Vergul bilan ajratilgan ruxsat etilgan domenlar
DJANGO_ALLOWED_HOSTS=*

# POST formalar uchun ishonchli manzillar (https bilan)
DJANGO_CSRF_TRUSTED_ORIGINS=https://abdurahmon1006.pythonanywhere.com

# Aloqa formasi shu emailga xat yuboradi (Gmail uchun "App password" ishlatiladi)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=abdurahmonk1987@gmail.com
EMAIL_HOST_PASSWORD=bu-yerga-gmail-app-paroli
DEFAULT_FROM_EMAIL=abdurahmonk1987@gmail.com
